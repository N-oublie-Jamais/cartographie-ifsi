# Copier en .env SUR LE VPS. Ne pas partager le fichier .env.
# Sous-domaine SANS https:// et SANS chemin. Exemple à adapter.
ATLAS_DOMAIN=cartographie-ifsi.noubliejamais.fr

# Secrets serveur : remplacer les valeurs vides.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=6008870
APP_PASSWORD=

# Vérifier ces noms dans la configuration Traefik existante du VPS.
TRAEFIK_NETWORK=root_default
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
